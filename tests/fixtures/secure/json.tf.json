{
  "resource": {
    "aws_s3_bucket": {
      "json_model_artifacts": {
        "bucket": "acme-json-model-artifacts"
      }
    },
    "aws_s3_bucket_public_access_block": {
      "json_model_artifacts": {
        "bucket": "${aws_s3_bucket.json_model_artifacts.id}",
        "block_public_acls": true,
        "block_public_policy": true,
